@model SafeSchoolApp.Models.ForumPost
@{
    ViewData["Title"] = Model.Title + " - Diễn Đàn SafeSchool";
}

<div style="max-width: 860px; margin: 0 auto;">
    <a href="/Forum" style="display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px; font-weight: 700; color: var(--primary);">
        <i class="bi bi-arrow-left"></i> Quay lại diễn đàn
    </a>

    <!-- MAIN POST -->
    <div class="card" style="padding: 32px; margin-bottom: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span class="badge @(Model.IsAnonymous ? "badge-anon" : "badge-success")">
                    <i class="bi @(Model.IsAnonymous ? "bi-incognito" : "bi-person-check-fill")"></i> @Model.AuthorName
                </span>
                <span class="badge badge-emergency" style="background: var(--primary-light); color: var(--primary-hover);">
                    @Model.Category
                </span>
            </div>
            <small style="color: var(--text-muted);"><i class="bi bi-clock"></i> @Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")</small>
        </div>

        <h1 style="font-size: 1.8rem; font-weight: 800; color: var(--text-main); margin-bottom: 16px;">
            @Model.Title
        </h1>

        <div style="font-size: 1.05rem; line-height: 1.7; color: #334155; white-space: pre-line; margin-bottom: 24px;">
            @Model.Content
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); padding-top: 16px;">
            <button onclick="likePost(@Model.Id, this)" class="btn btn-secondary">
                <i class="bi bi-heart-fill" style="color: #ef4444;"></i> <span class="like-count">@Model.LikesCount</span> Thích bài viết
            </button>
            <span style="color: var(--text-muted); font-size: 0.9rem;"><i class="bi bi-chat-dots-fill"></i> @Model.Comments.Count Bình luận</span>
        </div>
    </div>

    <!-- COMMENTS SECTION -->
    <div class="card" style="padding: 32px;">
        <h3 style="font-size: 1.3rem; font-weight: 800; margin-bottom: 24px; color: var(--text-main);">
            <i class="bi bi-chat-left-text-fill" style="color: var(--primary);"></i> Thảo luận & Lời khuyên (@Model.Comments.Count)
        </h3>

        <!-- ADD COMMENT FORM -->
        <form method="post" action="/Forum/AddComment" style="margin-bottom: 32px; background: #f8fafc; padding: 20px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
            <input type="hidden" name="postId" value="@Model.Id" />
            
            <div class="form-group">
                <textarea name="content" rows="3" class="form-control" placeholder="Viết lời khuyên hoặc chia sẻ của bạn để động viên bạn học..." required></textarea>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <input type="checkbox" name="isAnonymous" value="true" id="cmtAnonCheck" checked style="width: 18px; height: 18px;" />
                    <input type="hidden" name="isAnonymous" value="false" />
                    <label for="cmtAnonCheck" style="margin: 0; cursor: pointer; font-weight: 600; font-size: 0.9rem;">
                        <i class="bi bi-incognito"></i> Bình luận ẩn danh
                    </label>
                </div>

                <button type="submit" class="btn btn-primary" style="padding: 8px 20px;">
                    <i class="bi bi-send-fill"></i> Gửi bình luận
                </button>
            </div>
        </form>

        <!-- COMMENT LIST -->
        <div style="display: flex; flex-direction: column; gap: 16px;">
            @if (!Model.Comments.Any())
            {
                <p style="color: var(--text-muted); text-align: center; padding: 20px;">Chưa có bình luận nào. Hãy gửi lời động viên đầu tiên!</p>
            }
            else
            {
                @foreach (var cmt in Model.Comments.OrderByDescending(c => c.CreatedAt))
                {
                    <div style="background: #ffffff; padding: 16px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                            <span class="badge @(cmt.IsAnonymous ? "badge-anon" : "badge-success")">
                                @cmt.AuthorName
                            </span>
                            <small style="color: var(--text-muted);">@cmt.CreatedAt.ToString("HH:mm dd/MM")</small>
                        </div>
                        <p style="color: var(--text-main); font-size: 0.95rem; line-height: 1.5;">@cmt.Content</p>
                    </div>
                }
            }
        </div>
    </div>
</div>
