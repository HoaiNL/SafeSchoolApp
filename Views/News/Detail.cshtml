@model SafeSchoolApp.Models.NewsArticle
@{
    ViewData["Title"] = Model.Title + " - SafeSchool";
    var related = ViewBag.RelatedNews as List<SafeSchoolApp.Models.NewsArticle> ?? new List<SafeSchoolApp.Models.NewsArticle>();
}

<div style="max-width: 840px; margin: 0 auto;">
    <a href="/News" style="display: inline-flex; align-items: center; gap: 6px; margin-bottom: 24px; font-weight: 700; color: var(--primary);">
        <i class="bi bi-arrow-left"></i> Quay lại danh sách tin tức
    </a>

    <article class="card" style="padding: 40px; margin-bottom: 40px;">
        <span class="badge badge-success" style="margin-bottom: 16px; padding: 6px 14px;">@Model.Category</span>
        <h1 style="font-size: 2.2rem; font-weight: 800; color: var(--text-main); margin-bottom: 16px; line-height: 1.3;">
            @Model.Title
        </h1>

        <div style="display: flex; gap: 20px; color: var(--text-muted); font-size: 0.9rem; border-bottom: 1px solid var(--border-color); padding-bottom: 20px; margin-bottom: 28px;">
            <span><i class="bi bi-person-fill"></i> @Model.Author</span>
            <span><i class="bi bi-calendar3"></i> @Model.PublishedDate.ToString("dd/MM/yyyy")</span>
            <span><i class="bi bi-clock-fill"></i> @Model.ReadTime</span>
        </div>

        <div style="font-size: 1.1rem; line-height: 1.8; color: #334155; white-space: pre-line; margin-bottom: 32px;">
            @Model.Content
        </div>

        <!-- EMERGENCY BOX INSIDE ARTICLE -->
        <div style="background: var(--rose-light); border: 1px solid #fca5a5; border-radius: 12px; padding: 20px; margin-top: 32px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <div>
                <strong style="color: #991b1b; display: block; font-size: 1.05rem;">Cần hỗ trợ khẩn cấp?</strong>
                <span style="color: #7f1d1d; font-size: 0.9rem;">Gọi ngay Tổng đài Quốc gia 111 hoặc gửi Báo cáo Ẩn danh.</span>
            </div>
            <a href="/Report" class="btn btn-danger"><i class="bi bi-shield-lock-fill"></i> Gửi Báo Cáo Ẩn Danh</a>
        </div>
    </article>

    @if (related.Any())
    {
        <h3 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 20px; color: var(--text-main);">Bài viết liên quan</h3>
        <div class="grid-3" style="margin-bottom: 40px;">
            @foreach (var item in related)
            {
                <div class="card">
                    <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 8px;">
                        <a href="/News/Detail/@item.Id" style="color: var(--text-main);">@item.Title</a>
                    </h4>
                    <p style="font-size: 0.85rem; color: var(--text-muted);">@item.Summary</p>
                </div>
            }
        </div>
    }
</div>
